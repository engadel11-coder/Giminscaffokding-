        </div>
    </header>

    <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">

        <aside class="w-full lg:w-96 bg-slate-900/90 backdrop-blur border-l border-slate-800 p-5 overflow-y-auto flex flex-col gap-6 z-10">

            <div class="space-y-3">
                <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
                    <span>📐</span> أبعاد هيكل السقالة
                </h2>

                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">أعمدة X</label>
                        <input type="number" id="gridX" value="3" min="1" max="6" class="w-full bg-slate-800 border border-slate-700 rounded px-2.5 py-1.5 text-center text-sm focus:outline-none focus:border-amber-500">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">أعمدة Y</label>
                        <input type="number" id="gridY" value="2" min="1" max="6" class="w-full bg-slate-800 border border-slate-700 rounded px-2.5 py-1.5 text-center text-sm focus:outline-none focus:border-amber-500">
                    </div>
                    <div>
                        <label class="text-xs text-slate-400 block mb-1">الطوابق Z</label>
                        <input type="number" id="gridZ" value="3" min="1" max="10" class="w-full bg-slate-800 border border-slate-700 rounded px-2.5 py-1.5 text-center text-sm focus:outline-none focus:border-amber-500">
                    </div>
                </div>

                <div class="space-y-2 pt-2">
                    <div>
                        <div class="flex justify-between text-xs text-slate-400 mb-1">
                            <span>طول الباية (Bay Length):</span>
                            <span id="val-length" class="text-slate-200 font-medium">2.5 م</span>
                        </div>
                        <input type="range" id="bayLength" min="1.0" max="3.0" step="0.5" value="2.5" class="w-full accent-amber-500 cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-xs text-slate-400 mb-1">
                            <span>عرض الباية (Bay Width):</span>
                            <span id="val-width" class="text-slate-200 font-medium">1.2 م</span>
                        </div>
                        <input type="range" id="bayWidth" min="0.8" max="2.0" step="0.2" value="1.2" class="w-full accent-amber-500 cursor-pointer">
                    </div>
                    <div>
                        <div class="flex justify-between text-xs text-slate-400 mb-1">
                            <span>ارتفاع الطابق (Lift Height):</span>
                            <span id="val-height" class="text-slate-200 font-medium">2.0 م</span>
                        </div>
                        <input type="range" id="liftHeight" min="1.5" max="2.5" step="0.25" value="2.0" class="w-full accent-amber-500 cursor-pointer">
                    </div>
                </div>
            </div>

            <hr class="border-slate-800">

            <div class="space-y-3">
                <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
                    <span>👁️</span> طبقات العرض
