            <hr class="border-slate-800">

            <div class="space-y-3 flex-1 flex flex-col">
                <h2 class="text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
                    <span>📊</span> قائمة الكميات والأوزان
                </h2>
                <div class="bg-slate-950/60 border border-slate-800 rounded-lg p-3 text-xs space-y-2 overflow-y-auto max-h-52">
                    <table class="w-full text-right">
                        <thead>
                            <tr class="text-slate-400 border-b border-slate-800 pb-1">
                                <th class="pb-1">المكون</th>
                                <th class="pb-1 text-center">العدد</th>
                                <th class="pb-1 text-left">الوزن الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody id="bom-table-body" class="divide-y divide-slate-900">
                        </tbody>
                    </table>
                </div>
                <div class="bg-slate-800/80 p-3 rounded-lg border border-slate-700 flex justify-between items-center text-xs">
                    <span class="text-slate-300 font-semibold">إجمالي وزن الهيكل:</span>
                    <span id="total-weight" class="text-amber-400 font-bold text-sm">0 كجم</span>
                </div>
            </div>

            <button id="btn-update" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2.5 px-4 rounded-lg shadow transition duration-200">
                تحديث النموذج الهندسي
            </button>
        </aside>

        <main class="flex-1 relative bg-slate-950">
            <div id="webgl-container" class="w-full h-full"></div>

            <div class="absolute top-4 left-4 bg-slate-900/80 backdrop-blur border border-slate-800 p-1.5 rounded-lg flex gap-2 shadow-lg">
                <button onclick="setCameraView('iso')" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-xs rounded transition">أيزومتري</button>
                <button onclick="setCameraView('front')" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-xs rounded transition">أمامي</button>
                <button onclick="setCameraView('side')" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-xs rounded transition">جانبي</button>
                <button onclick="setCameraView('top')" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-xs rounded transition">علوي</button>
            </div>

            <div class="absolute bottom-4 right-4 bg-slate-900/80 backdrop-blur border border-slate-800 px-3 py-2 rounded-lg text-xs text-slate-400 pointer-events-none">
                💡 اسحب بالماوس للتدوير | استخدم عجلة الماوس للتقريب | انقر مع اليمين للتحريك
            </div>
        </main>
    </div>

    <script>
        let scene, camera, renderer, controls;
        let scaffoldingGroup = new THREE.Group();

        function init() {
            const container = document.getElementById('webgl-container');

            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x090d16);
            scene.fog = new THREE.FogExp2(0x090d16, 0.015);

            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(15, 12, 15);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            renderer.shadowMap.enabled = true;
            container.appendChild(renderer.domElement);

            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.target.set(0, 4, 0);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(20, 40, 20);
            dirLight.castShadow = true;
            scene.add(dirLight);

            const gridHelper = new THREE.GridHelper(40, 40, 0x334155, 0x1e293b);
            gridHelper.position.y = -0.01;
            scene.add(gridHelper);

            scene.add(scaffoldingGroup);

            buildScaffolding();

            window.addEventListener('resize', onWindowResize);

            document.getElementById('btn-update').addEventListener('click', buildScaffolding);
            ['bayLength', 'bayWidth', 'liftHeight'].forEach(id => {
                document.getElementById(id).addEventListener('input', (e) => {
                    document.getElementById('val-' + (id === 'bayLength' ? 'length' : id === 'bayWidth' ? 'width' : 'height')).innerText = e.target.value + ' م';
                });
            });
            ['toggle-decks', 'toggle-braces', 'toggle-rails', 'toggle-ties'].forEach(id => {
                document.getElementById(id).addEventListener('change', buildScaffolding);
            });
            ['gridX', 'gridY', 'gridZ'].forEach(id => {
                document.getElementById(id).addEventListener('input', buildScaffolding);
            });

            animate();
        }

        function onWindowResize() {
            const container = document.getElementById('webgl-container');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        function buildScaffolding() {
            while (scaffoldingGroup.children.length > 0) {
                scaffoldingGroup.remove(scaffoldingGroup.children[0]);
            }

            const nx = parseInt(document.getElementById('gridX').value);
            const ny = parseInt(document.getElementById('gridY').value);
            const nz = parseInt(document.getElementById('gridZ').value);
            const lX = parseFloat(document.getElementById('bayLength').value);
            const lY = parseFloat(document.getElementById('bayWidth').value);
            const hZ = parseFloat(document.getElementById('liftHeight').value);

            const showDecks = document.getElementById('toggle-decks').checked;
            const showBraces = document.getElementById('toggle-braces').checked;
            const showRails = document.getElementById('toggle-rails').checked;
            const showTies = document.getElementById('toggle-ties').checked;

            const standardMat = new THREE.MeshStandardMaterial({ color: 0x2563eb, metalness: 0.8, roughness: 0.2 });
            const ledgerMat = new THREE.MeshStandardMaterial({ color: 0xeab308, metalness: 0.7, roughness: 0.3 });
            const deckMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, metalness: 0.5, roughness: 0.4 });
            const jackMat = new THREE.MeshStandardMaterial({ color: 0x475569, metalness: 0.9, roughness: 0.1 });
            const braceMat = new THREE.MeshStandardMaterial({ color: 0xd97706, metalness: 0.6 });

            let totalStandards = (nx + 1) * (ny + 1);
            let standardCount = totalStandards * (nz + 1);
            let ledgerCount = 0;
            let transomCount = 0;
            let deckCount = 0;
            let braceCount = 0;

            const startX = -(nx * lX) / 2;
            const startY = -(ny * lY) / 2;

            for (let i = 0; i <= nx; i++) {
                for (let j = 0; j <= ny; j++) {
                    const xPos = startX + i * lX;
                    const zPos = startY + j * lY;

                    const jackGeo = new THREE.CylinderGeometry(0.04, 0.04, 0.4, 16);
                    const jack = new THREE.Mesh(jackGeo, jackMat);
                    jack.position.set(xPos, 0.2, zPos);
                    scaffoldingGroup.add(jack);

                    const totalH = (nz + 1) * hZ;
                    const stdGeo = new THREE.CylinderGeometry(0.024, 0.024, totalH, 16);
                    const std = new THREE.Mesh(stdGeo, standardMat);
                    std.position.set(xPos, totalH / 2 + 0.4, zPos);
                    scaffoldingGroup.add(std);

                    for (let k = 0; k <= nz; k++) {
                        const cupGeo = new THREE.CylinderGeometry(0.035, 0.035, 0.08, 16);
                        const cup = new THREE.Mesh(cupGeo, jackMat);
                        cup.position.set(xPos, 0.4 + k * hZ, zPos);
                        scaffoldingGroup.add(cup);
                    }
                }
            }

            for (let k = 0; k <= nz; k++) {
                const height = 0.4 + k * hZ;

                for (let j = 0; j <= ny; j++) {
                    for (let i = 0; i < nx; i++) {
                        const xPos = startX + i * lX + lX / 2;
                        const zPos = startY + j * lY;
                        const ledGeo = new THREE.CylinderGeometry(0.02, 0.02, lX, 12);
                        const led = new THREE.Mesh(ledGeo, ledgerMat);
                        led.rotation.z = Math.PI / 2;
                        led.position.set(xPos, height, zPos);
                        scaffoldingGroup.add(led);
                        ledgerCount++;
                    }
                }

                for (let i = 0; i <= nx; i++) {
                    for (let j = 0; j < ny; j++) {
                        const xPos = startX + i * lX;
                        const zPos = startY + j * lY + lY / 2;
                        const transGeo = new THREE.CylinderGeometry(0.02, 0.02, lY, 12);
                        const trans = new THREE.Mesh(transGeo, ledgerMat);
                        trans.rotation.x = Math.PI / 2;
                        trans.position.set(xPos, height, zPos);
                        scaffoldingGroup.add(trans);
                        transomCount++;
                    }
                }

                if (showDecks && k > 0) {
                    for (let i = 0; i < nx; i++) {
                        for (let j = 0; j < ny; j++) {
                            const xPos = startX + i * lX + lX / 2;
                            const zPos = startY + j * lY + lY / 2;
                            const deckGeo = new THREE.BoxGeometry(lX * 0.95, 0.05, lY * 0.95);
                            const deck = new THREE.Mesh(deckGeo, deckMat);
                            deck.position.set(xPos, height, zPos);
                            scaffoldingGroup.add(deck);
                            deckCount++;
                        }
                    }
                }

                if (showRails && k === nz) {
                    const railHeight1 = height + 0.5;
                    const railHeight2 = height + 1.0;
                    [railHeight1, railHeight2].forEach(rh => {
                        for (let j = 0; j <= ny; j++) {
                            for (let i = 0; i < nx; i++) {
                                const xPos = startX + i * lX + lX / 2;
                                const zPos = startY + j * lY;
                                const railGeo = new THREE.CylinderGeometry(0.015, 0.015, lX, 10);
                                const rail = new THREE.Mesh(railGeo, ledgerMat);
                                rail.rotation.z = Math.PI / 2;
                                rail.position.set(xPos, rh, zPos);
                                scaffoldingGroup.add(rail);
                            }
                        }
                        for (let i = 0; i <= nx; i++) {
                            for (let j = 0; j < ny; j++) {
                                const xPos = startX + i * lX;
                                const zPos = startY + j * lY + lY / 2;
                                const railGeo = new THREE.CylinderGeometry(0.015, 0.015, lY, 10);
                                const rail = new THREE.Mesh(railGeo, ledgerMat);
                                rail.rotation.x = Math.PI / 2;
                                rail.position.set(xPos, rh, zPos);
                                scaffoldingGroup.add(rail);
                            }
                        }
                    });
                }
            }

            if (showBraces) {
                for (let i = 0; i < nx; i++) {
                    const xPos = startX + i * lX + lX / 2;
                    const totalH = (nz + 1) * hZ;
                    const diagLength = Math.sqrt(Math.pow(lX, 2) + Math.pow(totalH, 2));
                    const diagGeo = new THREE.CylinderGeometry(0.018, 0.018, diagLength, 10);
                    const diag = new THREE.Mesh(diagGeo, braceMat);
                    diag.position.set(xPos, totalH / 2 + 0.4, startY);
                    diag.rotation.z = Math.atan2(lX, totalH);
                    scaffoldingGroup.add(diag);
                    braceCount++;
                }
                for (let j = 0; j < ny; j++) {
                    const zPos = startY + j * lY + lY / 2;
                    const totalH = (nz + 1) * hZ;
                    const diagLength = Math.sqrt(Math.pow(lY, 2) + Math.pow(totalH, 2));
                    const diagGeo = new THREE.CylinderGeometry(0.018, 0.018, diagLength, 10);
                    const diag = new THREE.Mesh(diagGeo, braceMat);
                    diag.position.set(startX, totalH / 2 + 0.4, zPos);
                    diag.rotation.x = Math.atan2(lY, totalH);
                    scaffoldingGroup.add(diag);
                    braceCount++;
                }
            }

            if (showTies) {
                const tieMat = new THREE.MeshStandardMaterial({ color: 0x64748b, metalness: 0.8 });
                for (let k = 1; k <= nz; k++) {
                    const height = 0.4 + k * hZ;
                    for (let i = 0; i <= nx; i++) {
                        const xPos = startX + i * lX;
                        const tieGeo = new THREE.CylinderGeometry(0.03, 0.03, 0.6, 8);
                        const tie = new THREE.Mesh(tieGeo, tieMat);
                        tie.rotation.x = Math.PI / 2;
                        tie.position.set(xPos, height, startY - 0.3);
                        scaffoldingGroup.add(tie);
                    }
                }
            }

            updateBOM(standardCount, ledgerCount, transomCount, deckCount, braceCount);
        }

        function updateBOM(std, led, trans, deck, brace) {
            const tbody = document.getElementById('bom-table-body');
            tbody.innerHTML = '';

            const items = [
                { name: 'أعمدة رأسية (Standards)', count: std, unitWeight: 12.5 },
                { name: 'عوارض أفقية (Ledgers)', count: led, unitWeight: 6.2 },
                { name: 'عوارض مستعرضة (Transoms)', count: trans, unitWeight: 5.1 },
                { name: 'ألواح فولاذية (Steel Decks)', count: deck, unitWeight: 14.0 },
                { name: 'دعامات مائلة (Braces)', count: brace, unitWeight: 8.5 }
            ];

            let totalW = 0;
            items.forEach(item => {
                const itemTotalWeight = item.count * item.unitWeight;
                totalW += itemTotalWeight;
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-900/50">
                        <td class="py-1.5">${item.name}</td>
                        <td class="py-1.5 text-center font-medium">${item.count}</td>
                        <td class="py-1.5 text-left text-amber-400">${itemTotalWeight.toLocaleString()} كجم</td>
                    </tr>
                `;
            });

            document.getElementById('total-weight').innerText = totalW.toLocaleString() + ' كجم';
        }

        function setCameraView(view) {
            controls.target.set(0, 4, 0);
            switch (view) {
                case 'iso': camera.position.set(15, 12, 15); break;
                case 'front': camera.position.set(0, 5, 20); break;
                case 'side': camera.position.set(20, 5, 0); break;
                case 'top': camera.position.set(0, 25, 0.1); break;
            }
            controls.update();
        }

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }

        window.onload = init;
    </script>

    <script>
        const SW_CODE = `
            const CACHE_NAME = 'cuplock-pwa-v1';
            const CORE_ASSETS = ['./', './index.html'];

            self.addEventListener('install', (event) => {
                self.skipWaiting();
                event.waitUntil(
                    caches.open(CACHE_NAME).then((cache) => {
                        return cache.addAll(CORE_ASSETS).catch(() => {});
                    })
                );
            });

            self.addEventListener('activate', (event) => {
                event.waitUntil(
                    caches.keys().then((keys) => {
                        return Promise.all(
                            keys.filter(k => k !== CACHE_NAME).map(k => caches.delete(k))
                        );
                    }).then(() => self.clients.claim())
                );
            });

            self.addEventListener('fetch', (event) => {
                if (event.request.method !== 'GET') return;
                event.respondWith(
                    caches.match(event.request).then((cached) => {
                        if (cached) return cached;
                        return fetch(event.request).then((response) => {
                            if (response && response.status === 200) {
                                const clone = response.clone();
                                caches.open(CACHE_NAME).then((cache) => {
                                    cache.put(event.request, clone).catch(() => {});
                                });
                            }
                            return response;
                        }).catch(() => {
                            return caches.match('./index.html');
                        });
                    })
                );
            });
        `;

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                const blob = new Blob([SW_CODE], { type: 'application/javascript' });
                const swUrl = URL.createObjectURL(blob);
                navigator.serviceWorker.register(swUrl, { scope: './' })
                    .then(() => console.log('✅ Service Worker registered'))
                    .catch(err => console.warn('⚠️ SW registration failed:', err));
            });
        }

        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splash');
                if (splash) splash.classList.add('hide');
                setTimeout(() => splash && splash.remove(), 600);
            }, 700);
        });

        let deferredPrompt = null;
        const installBtn = document.getElementById('install-btn');

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            installBtn.classList.add('show');
        });

        installBtn.addEventListener('click', async () => {
            if (!deferredPrompt) return;
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            if (outcome === 'accepted') installBtn.classList.remove('show');
            deferredPrompt = null;
        });

        window.addEventListener('appinstalled', () => {
            installBtn.classList.remove('show');
            deferredPrompt = null;
        });

        const offlineBadge = document.getElementById('offline-badge');
        function updateOnlineStatus() {
            if (navigator.onLine) offlineBadge.classList.remove('show');
            else offlineBadge.classList.add('show');
        }
        window.addEventListener('online', updateOnlineStatus);
        window.addEventListener('offline', updateOnlineStatus);
        updateOnlineStatus();
    </script>
</body>
